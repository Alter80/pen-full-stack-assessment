# Copy this file to .env and adjust if needed.
# Matches the credentials in docker-compose.yml out of the box.
DATABASE_URL="postgresql://sms:sms@localhost:5433/sms?schema=public"

# Direct (unpooled) connection used only for migrations. For local Postgres
# leave it equal to DATABASE_URL. For a hosted pooler (e.g. Neon) set this to
# the non-pooler connection string.
DIRECT_URL="postgresql://sms:sms@localhost:5433/sms?schema=public"
